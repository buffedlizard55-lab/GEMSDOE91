# Competition data must never be committed (data-use terms unchecked, and it is
# large). data/ is the local tree the entrant's machine also uses.
data/

# Built rasters are committed by the human when a slot is actually going to be
# spent (they are the upload artifact). Left ignored by default so this repo
# does not accumulate binaries with no receipt.
releases/*.tif
releases/*.zip

*.part
__pycache__/
.pytest_cache/
.ruff_cache/

# synthetic test fixtures
tests/_tmp/
